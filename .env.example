# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# The public read key. Supabase now calls this "publishable"; older projects
# call it "anon". Either variable name works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...

# Optional, server-only. Bypasses RLS — needed for `npm run seed`, not for
# enquiries (the RLS insert policy allows the publishable key).
# Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Used for absolute URLs in metadata / sitemap
NEXT_PUBLIC_SITE_URL=https://communicationevent.in

# Seconds before a content page re-checks Supabase. 0 = always fresh.
CONTENT_REVALIDATE_SECONDS=60

# Optional: set this and point a Supabase Database Webhook at
# POST /api/revalidate?secret=... to make edits appear instantly.
REVALIDATE_SECRET=
